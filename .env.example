PAYLOAD_SECRET=change-me-to-32+random-chars-min
DATABASE_URI=file:./belfast.db
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# First admin (created automatically on first local boot if no users exist)
PAYLOAD_FIRST_USER_EMAIL=admin@belfast.pub
PAYLOAD_FIRST_USER_PASSWORD=admin123

# ---- Vercel production (optional, for persistent CMS) ----
# Without these, Vercel uses an ephemeral /tmp DB and the site gracefully
# falls back to the static catalogue via /api/catalog. Admin edits on Vercel
# require Turso (free tier): https://turso.tech
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=your-token
# PAYLOAD_SECRET=set-a-long-random-secret-in-vercel-env
# NEXT_PUBLIC_SERVER_URL=https://your-app.vercel.app
